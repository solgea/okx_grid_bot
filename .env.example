# OKX credentials
API_KEY=
API_SECRET=
PASSPHRASE=

# Safety: keep these true until demo validation is complete.
IS_DEMO=true
DRY_RUN=true

# Unified CCXT symbol. The native OKX instrument id is derived from it
# (ETH/USDT:USDT -> ETH-USDT-SWAP) and is used by the bot, the paper book
# and the OKX Demo panel alike.
SYMBOL=ETH/USDT:USDT
LEVERAGE=10
MARGIN_MODE=cross
TIMEFRAME=15m

LOWER_PRICE=2500
UPPER_PRICE=2800
GRID_COUNT=10
CONTRACT_SIZE=0.01
MAX_POSITION_SIZE=0.10

MAX_DRAWDOWN_PCT=20
MAX_DAILY_LOSS_USDT=500
KILL_SWITCH_ACTIVE=true
MARKET_DATA_MAX_AGE_SEC=30
